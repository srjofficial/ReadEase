# ==============================================================================
# ReadEase Server Environment Variables (Node.js + Express)
# ==============================================================================

# Runtime Environment (development | production | test)
NODE_ENV=development

# Server Port
PORT=5000

# API Route Prefix
API_PREFIX=/api/v1

# MongoDB Connection URI (Local or MongoDB Atlas cluster connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/readease?retryWrites=true&w=majority

# MongoDB Database & Vector Index Configuration
MONGODB_DATABASE_NAME=readease
MONGODB_VECTOR_INDEX_NAME=readease_vector_index

# JWT Authentication Secrets (Must be min 32 chars in production)
JWT_SECRET=change_me_to_a_secure_random_string_at_least_32_chars_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_to_a_secure_refresh_secret_string_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# LLM API Key (Google Gemini / OpenAI / Anthropic)
LLM_API_KEY=your_llm_api_key_placeholder

# CORS Configuration (Comma-separated allowed client origins)
CORS_ORIGIN=http://localhost:5173

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# AI Microservice Internal Endpoint
AI_SERVICE_URL=http://localhost:8000
