# ==============================================================================
# ReadEase Consolidated Monorepo Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` for root orchestration, or reference individual service
# `.env.example` templates in `client/`, `server/`, and `ai-service/`.

# ------------------------------------------------------------------------------
# 1. Express Backend Server (`server/`)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database & Vector Index (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/readease?retryWrites=true&w=majority
MONGODB_DATABASE_NAME=readease
MONGODB_VECTOR_INDEX_NAME=readease_vector_index

# Security & Authentication
JWT_SECRET=change_me_to_a_secure_random_string_at_least_32_chars_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_to_a_secure_refresh_secret_string_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# LLM Service Configuration (Groq LPU Acceleration)
# Obtain a free key from: https://console.groq.com/keys
LLM_PROVIDER=groq
LLM_API_KEY=gsk_your_groq_api_key_placeholder
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Internal AI Service URL
AI_SERVICE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 2. React Client (`client/`)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api/v1
VITE_AI_SERVICE_URL=http://localhost:8000
VITE_APP_TITLE="ReadEase - Accessible Reading Assistant"

# ------------------------------------------------------------------------------
# 3. Python AI Microservice (`ai-service/`)
# ------------------------------------------------------------------------------
AI_PORT=8000
AI_HOST=0.0.0.0
DEBUG=True
LOG_LEVEL=INFO
TESSERACT_CMD=
MAX_UPLOAD_SIZE_MB=25
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000,http://server:5000
