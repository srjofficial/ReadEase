# ==============================================================================
# ReadEase AI Microservice Environment Variables (Python + FastAPI)
# ==============================================================================

# Server Port and Host
AI_PORT=8000
AI_HOST=0.0.0.0

# Debug and Logging
DEBUG=True
LOG_LEVEL=INFO

# OCR Engine Path (Leave empty if tesseract is in PATH)
TESSERACT_CMD=

# File Limits
MAX_UPLOAD_SIZE_MB=25

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000,http://server:5000

# Optional LLM API Key (for summarization and phonetic syllabification)
LLM_API_KEY=your_llm_api_key_placeholder
